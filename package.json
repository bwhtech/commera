{
	"name": "commera",
	"version": "1.0.0",
	"description": "ShoeArena Frontend",
	"main": "index.js",
	"scripts": {
		"postinstall": "yarn tailwind:build",
		"build": "yarn tailwind:build && cd dashboard && yarn install && yarn build && node buildPlugins.js",
		"tailwind:watch": "npx @tailwindcss/cli -i ./commera/public/css/main.css -o ./commera/public/css/tailwind.css --watch",
		"tailwind:build": "npx @tailwindcss/cli -i ./commera/public/css/main.css -o ./commera/public/css/tailwind.css",
		"dupes": "npm run dupes:py && npm run dupes:vue",
		"dupes:py": "jscpd commera --format python --threshold 1",
		"dupes:vue": "jscpd dashboard/src --format vue,typescript,javascript --threshold 1",
		"dupes:report": "jscpd commera dashboard/src --format python,vue,typescript,javascript --reporters html,console --output .jscpd-report"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BuildWithHussain/commera.git"
	},
	"author": "BWH Studios",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/BuildWithHussain/commera/issues"
	},
	"homepage": "https://github.com/BuildWithHussain/commera#readme",
	"dependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/cli": "^4.0.14",
		"satori": "^0.10",
		"satori-html": "^0.3.2",
		"tailwindcss": "^4.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@tailwindcss/typography": "^0.5.16",
		"jscpd": "^4"
	}
}
