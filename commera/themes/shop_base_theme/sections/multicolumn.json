{
	"$schema": "../../section.schema.json",
	"name": "Multicolumn",
	"icon": "columns",
	"max_blocks": 12,
	"settings": [
		{ "id": "title", "type": "text", "label": "Heading", "translatable": true, "default": "" },
		{ "id": "columns_desktop", "type": "range", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
		{
			"id": "column_alignment",
			"type": "select",
			"label": "Column alignment",
			"options": [
				{ "value": "start", "label": "Start" },
				{ "value": "center", "label": "Center" }
			],
			"default": "center"
		}
	],
	"blocks": {
		"column": {
			"name": "Column",
			"icon": "column",
			"settings": [
				{ "id": "image", "type": "image", "label": "Image", "default": "" },
				{ "id": "image_alt", "type": "text", "label": "Image description", "translatable": true, "default": "", "info": "Read out by screen readers; describe what the image shows" },
				{
					"id": "title",
					"type": "text",
					"label": "Heading",
					"translatable": true,
					"default": { "en": "Column", "ar": "عمود" }
				},
				{
					"id": "text",
					"type": "textarea",
					"label": "Description",
					"translatable": true,
					"default": {
						"en": "Pair text with an image to focus on your chosen product, collection or story.",
						"ar": "اجمع النص مع صورة لتسليط الضوء على منتج أو مجموعة أو قصة."
					}
				},
				{ "id": "link_label", "type": "text", "label": "Link label", "translatable": true, "default": "" },
				{ "id": "link", "type": "url", "label": "Link", "default": "" }
			]
		}
	},
	"presets": [{ "name": "Multicolumn", "blocks": ["column", "column", "column"] }]
}
