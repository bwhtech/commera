{
	"$schema": "../../section.schema.json",
	"name": "Collection list",
	"icon": "grid",
	"max_blocks": 12,
	"settings": [
		{
			"id": "title",
			"type": "text",
			"label": "Heading",
			"translatable": true,
			"default": { "en": "Shop by collection", "ar": "تسوّق حسب المجموعة" }
		},
		{ "id": "columns_desktop", "type": "range", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 3 }
	],
	"blocks": {
		"featured_collection": {
			"name": "Collection",
			"icon": "folder",
			"settings": [
				{ "id": "collection", "type": "collection", "label": "Collection", "default": "" },
				{ "id": "image", "type": "image", "label": "Image", "default": "", "info": "Empty uses the collection's own image" }
			]
		}
	},
	"presets": [
		{ "name": "Collection list", "blocks": ["featured_collection", "featured_collection", "featured_collection"] }
	]
}
