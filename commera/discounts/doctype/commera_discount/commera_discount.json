			"no_copy": 1,
			"default": "0"
		},
		{
			"fieldname": "sales",
			"fieldtype": "Currency",
			"label": "Sales With The Discount",
			"options": "currency",
			"read_only": 1,
			"no_copy": 1,
			"default": "0"
		},
		{
			"fieldname": "section_reporting",
			"fieldtype": "Section Break",
			"label": "Reporting And Accounting",
			"collapsible": 1
		},
		{
			"fieldname": "campaign",
			"fieldtype": "Link",
			"label": "Campaign",
			"options": "UTM Campaign"
		},
		{
			"fieldname": "column_break_reporting",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "discount_account",
			"fieldtype": "Link",
			"label": "Discount Account",
