{% macro masthead(brand, kind, when) -%}
<header class="masthead">
	<div class="wordmark">
		{% if brand.logo %}<img src="{{ brand.logo }}" height="28" alt="">{% else %}<span class="mark">{{ brand.name[0] }}</span>{% endif %}
		{{ brand.name }}
	</div>
	<div class="doc-kind">
		<strong>{{ kind }}</strong>
		<span class="num">{{ when }}</span>
	</div>
</header>
{%- endmacro %}

{% macro hero(heading, lines, number_label, number, steps=None, label=None) -%}
<section class="hero">
	<div class="hero-top">
		<div>
			{% if label %}<div class="label">{{ label }}</div>{% endif %}
			<h1>{{ heading }}</h1>
			<p>{% for line in lines | select %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
		</div>
		<div class="doc-number">
			<span>{{ number_label }}</span>
			<b>{{ number }}</b>
		</div>
	</div>
	{% if steps %}{{ progress_steps(steps) }}{% endif %}
</section>
{%- endmacro %}

{% macro progress_steps(steps) -%}
{% set done_steps = steps | selectattr("done") | list %}
{% set current = done_steps | last if done_steps else steps[0] %}
{% set upcoming = steps[steps.index(current) + 1:] | selectattr("date") | first %}
<div class="steps">
	<div class="steps-status">
		<b>{{ current.title }}</b>
		<span class="num">{% if upcoming %}{{ upcoming.pending_title or upcoming.title }} {{ upcoming.date }}{% else %}{{ current.date }}{% endif %}</span>
	</div>
	<div class="steps-bar" style="grid-template-columns: repeat({{ steps | length }}, 1fr)">
		{% for step in steps %}<i class="{{ 'done' if step.done }}"></i>{% endfor %}
	</div>
	{% if current.detail %}<p class="steps-detail">{{ current.detail }}</p>{% endif %}
</div>
{%- endmacro %}

{% macro address_block(label, address=None, empty_text=None, extra_lines=[]) -%}
{% set extras = extra_lines | select | list %}
{% if address or empty_text %}
<div class="label">{{ label }}</div>
<address>
	{%- if address %}<b>{{ address.name }}</b>{% for line in address.lines %}<br>{{ line }}{% endfor %}
	{%- else %}{{ empty_text }}{% endif %}
	{%- for line in extras %}<br>{{ line }}{% endfor %}
</address>
{% endif %}
{%- endmacro %}

{% macro fact(label, title, detail=None) -%}
{{ address_block(label, {"name": title, "lines": []}, extra_lines=[detail]) }}
{%- endmacro %}

{% macro thumb(row) -%}
{% if row.image %}<img class="thumb" src="{{ row.image }}" alt="">{% else %}<div class="thumb empty">{{ row.item_name[0] }}</div>{% endif %}
{%- endmacro %}

{% macro product_cell(row, show_hsn=False, with_thumb=True) -%}
<div class="product">
	{% if with_thumb %}{{ thumb(row) }}{% endif %}
	<div>
		<div class="name">{{ row.item_name }}</div>
		<div class="meta">
			{%- if row.variant %}<span class="sku">{{ row.variant }}</span>{% endif -%}
			<span class="sku">SKU {{ row.item_code }}</span>
			{%- if show_hsn and row.gst_hsn_code %}<span class="sku">HSN <span class="num">{{ row.gst_hsn_code }}</span></span>{% endif -%}
		</div>
	</div>
</div>
{%- endmacro %}

{% macro items_table(items, money) -%}
<table class="items">
	<thead>
		<tr>
			<th>Product</th>
			<th class="r" style="width: 60px">Qty</th>
			<th class="r" style="width: 100px">Price</th>
			<th class="r" style="width: 100px">Amount</th>
		</tr>
	</thead>
	<tbody>
	{% for row in items %}
		<tr>
			<td>{{ product_cell(row) }}</td>
			<td class="r num">{{ row.qty | int }}</td>
			<td class="r num">
				{% if row.price_list_rate > row.rate %}<span class="strike">{{ money(row.price_list_rate) }}</span>{% endif %}
				{{ money(row.rate) }}
			</td>
			<td class="r num">{{ money(row.amount) }}</td>
		</tr>
	{% endfor %}
	</tbody>
</table>
{%- endmacro %}

{% macro notes(doc) -%}
{% if doc.customer_note or doc.gift_message %}
<div class="note">
	{% if doc.customer_note %}<div class="label">Your delivery note</div><p>{{ doc.customer_note }}</p>{% endif %}
	{% if doc.gift_message %}<div class="label">Gift message, printed on the card</div><p>{{ doc.gift_message }}</p>{% endif %}
</div>
{% else %}<div></div>{% endif %}
{%- endmacro %}

{% macro charge_rows(doc, money, highlight_discount=True) -%}
	<tr><td>Subtotal</td><td class="num">{{ money(doc.total) }}</td></tr>
	{% if doc.discount_amount %}
	<tr class="{{ 'discount' if highlight_discount }}"><td>Discount{% if doc.coupon_code %} ({{ doc.coupon_code }}){% endif %}</td><td class="num">&minus;{{ money(doc.discount_amount) }}</td></tr>
	{% endif %}
	{% for charge in doc.charges %}
	<tr><td>{{ charge.description }}</td><td class="num">{{ money(charge.amount) if charge.amount else "Free" }}</td></tr>
	{% endfor %}
{%- endmacro %}

{% macro totals(doc, money) -%}
<table class="totals">
	{{ charge_rows(doc, money) }}
	<tr class="grand"><td>Total</td><td class="num">{{ money(doc.grand_total) }}</td></tr>
	<tr class="tax-note"><td colspan="2" class="num">Includes {{ money(doc.tax_included) }} {{ doc.tax_label }}</td></tr>
</table>
{%- endmacro %}

{% macro footer(brand, closing) -%}
<footer class="footer">
	<div>
		{% if closing %}{{ closing }}<br>{% endif %}
		{{ brand.legal_name }}, {{ brand.address }}. <span class="nowrap">{{ brand.tax_id_label or "GSTIN" }} {{ brand.tax_id }}</span>
	</div>
	<div class="links">
		{% for link in brand.footer_links %}<a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}
		<br>{{ brand.support_email }}
	</div>
</footer>
{%- endmacro %}

{% macro line_items_table(items, money, quantity_label="Qty", amount_label="Amount") -%}
{% set show_hsn = items | selectattr("gst_hsn_code") | list %}
<table class="items">
	<thead>
		<tr>
			<th>Description</th>
			{% if show_hsn %}<th style="width: 90px">HSN/SAC</th>{% endif %}
			<th class="r" style="width: 70px">{{ quantity_label }}</th>
			<th class="r" style="width: 100px">Rate</th>
			<th class="r" style="width: 100px">{{ amount_label }}</th>
		</tr>
	</thead>
	<tbody>
	{% for row in items %}
		<tr>
			<td>{{ product_cell(row, with_thumb=False) }}</td>
			{% if show_hsn %}<td class="num">{{ row.gst_hsn_code }}</td>{% endif %}
			<td class="r num">{{ row.qty | int }}</td>
			<td class="r num">{{ money(row.rate) }}</td>
			<td class="r num">{{ money(row.amount) }}</td>
		</tr>
	{% endfor %}
	</tbody>
</table>
{%- endmacro %}

{% macro tax_breakdown(doc, money, label="Tax breakdown") -%}
<div>
	<div class="label">{{ label }}</div>
	<table class="tax-table">
		<thead><tr><th>Tax</th><th class="r">Taxable value</th><th class="r">Amount</th></tr></thead>
		<tbody>
		{% for tax in doc.taxes %}
			<tr><td>{{ tax.description }} <span class="num">{{ tax.rate }}%</span></td><td class="r num">{{ money(doc.net_total) }}</td><td class="r num">{{ money(tax.amount) }}</td></tr>
		{% endfor %}
		{% if doc.taxes | length > 1 %}
			<tr class="sum"><td>Total tax</td><td></td><td class="r num">{{ money(doc.total_taxes) }}</td></tr>
		{% endif %}
		</tbody>
	</table>
	{% if doc.place_of_supply %}<p class="tax-hint">Place of supply {{ doc.place_of_supply }}</p>{% endif %}
	{% if doc.in_words %}<p class="tax-hint">Amount in words: {{ doc.in_words }}</p>{% endif %}
</div>
{%- endmacro %}

{% macro invoice_totals(doc, money, total_label="Total", tax_label="Total tax", highlight_discount=True) -%}
<table class="totals invoice-totals">
	{{ charge_rows(doc, money, highlight_discount) }}
	{% if doc.discount_amount or doc.charges %}
	<tr><td>Taxable value</td><td class="num">{{ money(doc.net_total) }}</td></tr>
	{% endif %}
	<tr><td>{{ doc.taxes[0].description if doc.taxes | length == 1 else tax_label }}</td><td class="num">{{ money(doc.total_taxes) }}</td></tr>
	<tr class="grand"><td>{{ total_label }}</td><td class="num">{{ money(doc.grand_total) }}</td></tr>
</table>
{%- endmacro %}
